PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://<usuario>:<password>@<host>/<basededatos>?sslmode=require

JWT_SECRET=cambia_este_valor_en_produccion
JWT_EXPIRES_IN=1d

PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

MAX_RESERVAS_ACTIVAS_USUARIO=5

# US-14: horas mínimas de anticipación para cancelar una reserva.
HORAS_MIN_CANCELACION=2

# US-27: minutos de vigencia del enlace para verificar un correo nuevo.
EMAIL_CHANGE_TOKEN_EXPIRES_MIN=60

# US-28: pasarela de pago. "simulada" no necesita credenciales (tarjetas de prueba: 4242 4242 4242 4242 aprueba,
# ...0002 la rechaza y ...9995 simula fondos insuficientes).
PASARELA_PAGO=simulada
# Exigir HTTPS en las rutas de tarjetas (activar en producción detrás de un proxy con TLS).
EXIGIR_HTTPS_PAGOS=false
# Confiar en X-Forwarded-Proto del proxy para detectar HTTPS.
TRUST_PROXY=false

# Uno o varios orígenes separados por comas. En producción: solo el dominio del frontend de Vercel.
# En staging se admite un comodín para las previews del proyecto: https://canchaya-*.vercel.app
CORS_ORIGIN=http://localhost:5173

# Documentación de la API (Swagger UI en /api/docs). Por defecto: activa salvo NODE_ENV=production.
# API_DOCS_HABILITADA=true

# Con LOG_CORREO_DETALLE=true y sin SMTP, el log imprime los enlaces de los correos (solo desarrollo; por defecto
# queda desactivado en producción para no registrar tokens ni correos).
# LOG_CORREO_DETALLE=false

# Intervalo de la línea [METRICAS] con las conexiones de socket activas (ms).
# METRICAS_INTERVALO_MS=60000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CanchaYa <no-reply@canchaya.com>
