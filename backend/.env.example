PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://<usuario>:<password>@<host>/<basededatos>?sslmode=require

JWT_SECRET=cambia_este_valor_en_produccion
JWT_EXPIRES_IN=1d

PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

MAX_RESERVAS_ACTIVAS_USUARIO=5

