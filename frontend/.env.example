# Desarrollo local: backend en el puerto 4000.
VITE_API_URL=http://localhost:4000/api

# Producción y preview (se definen en el panel de Vercel, NO en un archivo): deben ser HTTPS.
#   VITE_API_URL=https://<servicio-backend>.up.railway.app/api
# Opcional: dirección del socket de reservas si fuera distinta a la de la API (por defecto, la API sin "/api").
#   VITE_SOCKET_URL=https://<servicio-backend>.up.railway.app
