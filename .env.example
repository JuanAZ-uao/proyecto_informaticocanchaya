# Variables para docker compose (copiar a .env en la raíz; .env no se sube al repo).
# Este entorno usa su propio Postgres en un contenedor, separado de la base de Neon.

JWT_SECRET=cambia_este_valor
POSTGRES_PASSWORD=canchaya

# Puertos en tu máquina
BACKEND_PORT=4100
FRONTEND_PORT=8080

# Opcional: correo para recuperación de contraseña
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
